{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["electron.vite.config.ts", "scripts/*.d.mts", "src/shared/**/*", "src/main/**/*", "src/preload/**/*", "e2e/**/*", "playwright.config.ts", "vitest.config.ts"]
}
